@inject NavigationManager NavigationManager

<MudBreadcrumbs Separator="/" MaxItems="5">
    @foreach (var segment in Segments)
    {
        if (segment.IsLast)
        {
            <MudBreadcrumbItem Disabled="true">@segment.Display</MudBreadcrumbItem>
        }
        else
        {
            <MudBreadcrumbItem Href="@segment.Url">@segment.Display</MudBreadcrumbItem>
        }
    }
</MudBreadcrumbs>

@code {
    private List<BreadcrumbSegment> Segments = new();

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var segments = uri.AbsolutePath
            .Split('/', StringSplitOptions.RemoveEmptyEntries);

        var currentPath = "";
        for (int i = 0; i < segments.Length; i++)
        {
            currentPath += "/" + segments[i];
            Segments.Add(new BreadcrumbSegment
            {
                Display = Capitalize(segments[i]),
                Url = currentPath,
                IsLast = (i == segments.Length - 1)
            });
        }

        if (Segments.Count == 0)
        {
            Segments.Add(new BreadcrumbSegment
            {
                Display = "Accueil",
                Url = "/",
                IsLast = true
            });
        }
    }

    private string Capitalize(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return "";
        return char.ToUpper(input[0]) + input[1..];
    }

    private class BreadcrumbSegment
    {
        public string Display { get; set; } = "";
        public string Url { get; set; } = "";
        public bool IsLast { get; set; }
    }
}
