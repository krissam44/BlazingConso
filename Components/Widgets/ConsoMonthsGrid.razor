@using BlazingConso.Entities
@using Syncfusion.Blazor.Grids
@using System.Globalization

<MudCard Class="card-custom-style" Style="height:100%">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Class="d-flex align-center justify-center mud-width-full" Typo="Typo.h6">Consommations Mensuelles</MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        <SfGrid @ref="ConsoMonthGrid" TValue="ConsoMonth" DataSource="@ConsoMonths" AllowPaging="false" RowHeight="28" Height="@GridHeight" ShowColumnChooser="true">

            <GridAggregates>
                <GridAggregate>
                    <GridAggregateColumns>
                        <GridAggregateColumn Field="@nameof(ConsoMonth.periode)" Type="Syncfusion.Blazor.Grids.AggregateType.Count" Format="N0">
                            <FooterTemplate>
                                @{
                                    <div>Totaux</div>
                                }
                            </FooterTemplate>
                        </GridAggregateColumn>
                        <GridAggregateColumn Field="@nameof(ConsoMonth.ConsoHCkWh)" Type="Syncfusion.Blazor.Grids.AggregateType.Sum" Format="N2">
                            <FooterTemplate>
                                @{
                                    var SumValue = (context as AggregateTemplateContext);
                                    <div>
                                        @SumValue.Sum
                                    </div>
                                }
                            </FooterTemplate>
                        </GridAggregateColumn>
                        <GridAggregateColumn Field="@nameof(ConsoMonth.ConsoHPkWh)" Type="Syncfusion.Blazor.Grids.AggregateType.Sum" Format="N2">
                            <FooterTemplate>
                                @{
                                    var SumValue = (context as AggregateTemplateContext);
                                    <div>
                                        @SumValue.Sum
                                    </div>
                                }
                            </FooterTemplate>
                        </GridAggregateColumn>
                        <GridAggregateColumn Field="@nameof(ConsoMonth.ConsoTotalekWh)" Type="Syncfusion.Blazor.Grids.AggregateType.Sum" Format="N2">
                            <FooterTemplate>
                                @{
                                    var SumValue = (context as AggregateTemplateContext);
                                    <div>
                                        @SumValue.Sum
                                    </div>
                                }
                            </FooterTemplate>
                        </GridAggregateColumn>
                        <GridAggregateColumn Field="@nameof(ConsoMonth.coutTotal)" Type="Syncfusion.Blazor.Grids.AggregateType.Sum" Format="C2">
                            <FooterTemplate>
                                @{
                                    var SumValue = (context as AggregateTemplateContext);
                                    <div>
                                        @SumValue.Sum
                                    </div>
                                }
                            </FooterTemplate>
                        </GridAggregateColumn>
                    </GridAggregateColumns>
                </GridAggregate>
                <GridAggregate>
                    <GridAggregateColumns>
                        <GridAggregateColumn Field="@nameof(ConsoMonth.periode)" Type="Syncfusion.Blazor.Grids.AggregateType.Count" Format="N0">
                            <FooterTemplate>
                                @{
                                    <div>Moyenne</div>
                                }
                            </FooterTemplate>
                        </GridAggregateColumn>
                        <GridAggregateColumn Field="@nameof(ConsoMonth.coutTotal)" Type="Syncfusion.Blazor.Grids.AggregateType.Average" Format="C2">
                            <FooterTemplate>
                                @{
                                    var AverageValue = (context as AggregateTemplateContext);
                                    <div>
                                        @AverageValue.Average
                                    </div>
                                }
                            </FooterTemplate>
                        </GridAggregateColumn>
                    </GridAggregateColumns>
                </GridAggregate>
            </GridAggregates>

            <GridColumns>
                <GridColumn Field=@nameof(ConsoMonth.periode) HeaderText="Période" TextAlign="TextAlign.Right" Width="111"></GridColumn>

                <GridColumn HeaderText="Consommation (kWh)" TextAlign="TextAlign.Center">
                    <GridColumns>
                        <GridColumn Field=@nameof(ConsoMonth.ConsoHPkWh) HeaderText="HP" Format="N2" TextAlign="TextAlign.Center" Width="80"></GridColumn>
                        <GridColumn Field=@nameof(ConsoMonth.ConsoHCkWh) HeaderText="HC" Format="N2" TextAlign="TextAlign.Center" Width="80"></GridColumn>
                        <GridColumn Field=@nameof(ConsoMonth.ConsoTotalekWh) HeaderText="Totale" Format="N2" TextAlign="TextAlign.Center" Width="80"></GridColumn>
                        <GridColumn Field=@nameof(ConsoMonth.ConsoMoyennekWh) HeaderText="Moyenne" Format="N2" TextAlign="TextAlign.Center" Width="80"></GridColumn>
                        <GridColumn Field=@nameof(ConsoMonth.ConsoMaxkWh) HeaderText="Max" Format="N2" TextAlign="TextAlign.Center" Width="79"></GridColumn>
                        <GridColumn Field=@nameof(ConsoMonth.ConsoMinkWh) HeaderText="Min" Format="N2" TextAlign="TextAlign.Center" Width="79"></GridColumn>
                    </GridColumns>
                </GridColumn>

                <GridColumn HeaderText="Coûts (€)" TextAlign="TextAlign.Center">
                    <GridColumns>
                        <GridColumn Field=@nameof(ConsoMonth.coutTotal) HeaderText="Global" TextAlign="TextAlign.Center" Format="F2" Width="76" />
                        <GridColumn Field=@nameof(ConsoMonth.coutConsommationHP) HeaderText="HP" TextAlign="TextAlign.Center" Format="F2" Width="68" />
                        <GridColumn Field=@nameof(ConsoMonth.coutConsommationHC) HeaderText="HC" TextAlign="TextAlign.Center" Format="F2" Width="68" />
                    </GridColumns>
                </GridColumn>

            </GridColumns>

        </SfGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public IEnumerable<ConsoMonth> ConsoMonths { get; set; }
    [Parameter] public string GridHeight { get; set; } = "480px";
    [Parameter] public string[] ToolbarItems { get; set; } = new string[] { "ColumnChooser" };

    private SfGrid<ConsoMonth> ConsoMonthGrid;
}

<style>
    .e-grid .e-rowcell {
        font-size: 13px;
    }

    /* Cache les scrollbars */
    .e-grid.no-scrollbar .e-content {
        overflow: hidden !important;
    }
</style>