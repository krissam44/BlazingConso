@page "/instantanee-linky"
@using BlazingConso.Entities
@using BlazingConso.Services.Interfaces
@inject IInfosConsoService InfosConsoService


<MudCard style="height:100%">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Class="mt-0 pt-0" Typo="Typo.h6">Instantanée LINKY</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.Sync" OnClick="@(async() => await ReloadInfoLinky())" Color="Color.Info" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid Class="pa-0">
            @if (infoLinky != null)
            {
                <MudItem xs="9" Class="d-flex justify-start pb-1">
                    <MudText Typo="Typo.body1" Color="Color.Info">Puissance consommée</MudText>
                </MudItem>
                <MudItem xs="3" Class="d-flex justify-end pb-1">
                    <MudText Style="font-weight: bold;" Typo="Typo.body1" Color="Color.Info">@(infoLinky.Puissance) W</MudText>
                </MudItem>

                <MudItem xs="6" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="Color.Info">Intensité</MudText>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="Color.Info">@(infoLinky.Intensite) A</MudText>
                </MudItem>

                <MudItem xs="6" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="Color.Info">Tension</MudText>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="Color.Info">@(infoLinky.Tension) V</MudText>
                </MudItem>

                <MudItem xs="9" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="Color.Info">Index Compteur Global</MudText>
                </MudItem>
                <MudItem xs="3" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="Color.Info">@(infoLinky.IndexTotal)</MudText>
                </MudItem>

                <MudItem xs="9" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="Color.Info">Index Compteur Heures Pleines</MudText>
                </MudItem>
                <MudItem xs="3" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="Color.Info">@(infoLinky.IndexHp)</MudText>
                </MudItem>

                <MudItem xs="9" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="Color.Info">Index Compteur Heures Creuses</MudText>
                </MudItem>
                <MudItem xs="3" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="Color.Info">@(infoLinky.IndexHc)</MudText>
                </MudItem>
            }
        </MudGrid>
    </MudCardContent>
</MudCard>


@code {
    [Parameter] public EventCallback OnReady { get; set; }  // Ajout du callback
    private InfoLinky infoLinky;

    protected override async Task OnInitializedAsync()
    {
        infoLinky = await InfosConsoService.GetInfoLinky();
    }

    private async Task ReloadInfoLinky()
    {
        // ----- Recharge les données quand l'utilisateur clique sur le bouton de synchronisation
        infoLinky = await InfosConsoService.GetInfoLinky();
        await OnReady.InvokeAsync(); // Notifier le parent
        StateHasChanged();
    }
}

    <style>
        .mud-card-header{
            padding-top: 2px;
        }

    .mud-icon-button{
        padding:6px;
    }
    </style>