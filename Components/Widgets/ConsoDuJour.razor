@page "/conso-du-jour"
@using BlazingConso.Entities
@inject IConsoDayService ConsodayService

<MudCard Class="card-custom-style" style="height:100%">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Consommation de la journée</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Rounded.Sync" Color="Color.Success" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid Class="pa-0">
            @if (consoToday != null)
            {
                <MudItem xs="7" Class="d-flex justify-start pb-1">
                    <MudText Typo="Typo.body1" Color="@Color.Success">Consommation</MudText>
                </MudItem>
                <MudItem xs="5" Class="d-flex justify-end pb-1">
                    <MudText Style="font-weight: bold;" Typo="Typo.body1" Color="@Color.Success">@(((double)consoToday.ConsoJourTotal / 1000).ToString("F2")) kWh</MudText>
                </MudItem>

                <MudItem xs="6" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="@Color.Success">Puissance Maximale</MudText>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="@Color.Success">@consoToday.PowerMax W à @consoToday.HeureMax.Substring(0,5)</MudText>
                </MudItem>

                <MudItem xs="6" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="@Color.Success">Puissance Minimale</MudText>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="@Color.Success">@consoToday.PowerMin W à @consoToday.HeureMin.Substring(0,5) </MudText>
                </MudItem>

                <MudItem xs="8" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="@Color.Success">Température Minimale</MudText>
                </MudItem>
                <MudItem xs="4" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="@Color.Success">@consoToday.TempMin °C</MudText>
                </MudItem>

                <MudItem xs="8" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="@Color.Success">Température Maximale</MudText>
                </MudItem>
                <MudItem xs="4" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="@Color.Success">@consoToday.TempMax °C</MudText>
                </MudItem>

                <MudItem xs="12" Class="d-flex justify-start pb-1 pt-0">                    
                    <MudText Typo="Typo.body1" Color="@Color.Success">@(consoToday.Tarif == 2 ? "Période Heure Creuse" : "Période Heure Pleine")</MudText>
                </MudItem>
            }
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public EventCallback OnReady { get; set; }  // Ajout du callback
    private ConsoDay? consoToday = null;

    protected override async Task OnInitializedAsync()
    {
        consoToday = await ConsodayService.GetConsoToday();
        await OnReady.InvokeAsync(); // Notifier le parent
        StateHasChanged();
    }
}
