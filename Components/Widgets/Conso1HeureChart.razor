@using BlazingConso.Dtos
@using BlazingConso.Entities
@using Syncfusion.Blazor.Charts
@using BlazingConso.Enums
@using System.Globalization

<MudCard Class="card-custom-style" Style="height:100%">
    <MudCardHeader Class="mud-card-header">
        <CardHeaderContent>
            <MudText Class="d-flex align-center justify-center mud-width-full" Typo="Typo.h6">@ChartTitle</MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent Class="pt-1">
        <SfChart Palettes="@ChartPalette" Width="100%" Height="@ChartHeight">
            <!-- Configuration de l'axe X pour afficher uniquement le jour -->
            <ChartPrimaryXAxis Title="Tranche Horaire"
                               ValueType="Syncfusion.Blazor.Charts.ValueType.Category"
                               LabelRotation="45"
                               Interval="1">
            </ChartPrimaryXAxis>

            <!-- Configuration de l'axe Y avec le format approprié -->
            <ChartPrimaryYAxis Title="@TitleY"
                               LabelFormat="@LabelFormat">
            </ChartPrimaryYAxis>

            <ChartTooltipSettings Enable="true" Format="<b>${point.x}</b> : ${point.y}"></ChartTooltipSettings>

            @if (ModeAffichage == ModeAffichage.kWh)
            {
                @* ----------------------- Graphe kWH ----------------------- *@
                <ChartSeriesCollection>
                    <!-- Série de données avec gestion des points vides -->
                    <ChartSeries DataSource="@consoChartData" XName="Periode" YName="Consommation"
                                 Type="Syncfusion.Blazor.Charts.ChartSeriesType.Column"
                                 ColumnWidth="0.8" ColumnSpacing="0.2"
                                 CornerRadius="@(new ChartCornerRadius { TopLeft = 4, TopRight = 4 })"
                                 Fill="#4a86ff">
                        <ChartEmptyPointSettings Mode="EmptyPointMode.Gap"></ChartEmptyPointSettings>
                    </ChartSeries>
                </ChartSeriesCollection>
            }
            else
            {
                @* ----------------------- Graphe € ----------------------- *@
                <ChartSeriesCollection>
                    <!-- Série de données avec gestion des points vides -->
                    <ChartSeries DataSource="@coutChartData" XName="Periode" YName="CoutConsommation"
                                 Type="Syncfusion.Blazor.Charts.ChartSeriesType.Column"
                                 ColumnWidth="0.8" ColumnSpacing="0.2"
                                 CornerRadius="@(new ChartCornerRadius { TopLeft = 4, TopRight = 4 })"
                                 Fill="#ffb545">
                        <ChartEmptyPointSettings Mode="EmptyPointMode.Gap"></ChartEmptyPointSettings>
                    </ChartSeries>
                </ChartSeriesCollection>
            }

            <ChartCrosshairSettings Enable="true" DashArray="2,3" LineType="LineType.Vertical"></ChartCrosshairSettings>
            <ChartZoomSettings EnableSelectionZooming="true"></ChartZoomSettings>
        </SfChart>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public IEnumerable<HistoPeriodConsoDto> consoChartData { get; set; }
    [Parameter] public IEnumerable<HistoPeriodCoutDto> coutChartData { get; set; }
    [Parameter] public ModeAffichage ModeAffichage { get; set; }
    [Parameter] public string ChartHeight { get; set; }

    private string ChartTitle => ModeAffichage == ModeAffichage.kWh ? "Consommation en kWh" : "Coûts Consommation sans abonnement (€)";
    private string TitleY => ModeAffichage == ModeAffichage.kWh ? "Consommation (kWh)" : "Coût (Euros)";
    private string LabelFormat => ModeAffichage == ModeAffichage.kWh ? "{value} kWh" : "{value} €";

    private static String[] ChartPalette = new String[] { "#4a86ff", "#ffb545", "#E94649", "#6FAAB0" };

}