@page "/conso-extrait"

@using MudColor = MudBlazor.Color
@using BlazingConso.Entities
@inject IInfosConsoService InfosConsoService

<MudCard style="height:100%">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Résumé Consommation</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.Sync" Color="MudColor.Warning" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid Class="pa-0">
            @if (consoResume != null)
            {
                <MudItem xs="9" Class="d-flex justify-start pb-1">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">Du jour</MudText>
                </MudItem>
                <MudItem xs="3" Class="d-flex justify-end pb-1">
                    <MudText Style="font-weight: bold;" Typo="Typo.body1" Color="MudColor.Warning">@(((double)consoResume.ConsoJour / 1000).ToString("F2")) kWh</MudText>
                </MudItem>

                <MudItem xs="6" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">De la veille</MudText>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">@(((double)consoResume.ConsoVeille / 1000).ToString("F2")) kWh</MudText>
                </MudItem>

                <MudItem xs="6" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">De la semaine en cours</MudText>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">@(((double)consoResume.ConsoHebdoEnCours / 1000).ToString("F2")) kWh</MudText>
                </MudItem>

                <MudItem xs="6" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">De la semaine précédente</MudText>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">@(((double)consoResume.ConsoHebdoPrecedent / 1000).ToString("F2")) kWh</MudText>
                </MudItem>

                <MudItem xs="6" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">Du mois en cours</MudText>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">@(((double)consoResume.ConsoMoisEnCours / 1000).ToString("F2")) kWh</MudText>
                </MudItem>

                <MudItem xs="6" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">Du mois précédent</MudText>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">@(((double)consoResume.ConsoMoisPrecedent / 1000).ToString("F2")) kWh</MudText>
                </MudItem>

                <MudItem xs="9" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">De l'heure précédente</MudText>
                </MudItem>
                <MudItem xs="3" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">@(consoResume.ConsoHeurePrecedent) Wh</MudText>
                </MudItem>

                <MudItem xs="6" Class="d-flex justify-start pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">Des 30 dernières minutes</MudText>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end pb-1 pt-0">
                    <MudText Typo="Typo.body1" Color="MudColor.Warning">@(consoResume.ConsoLast30mn) Wh</MudText>
                </MudItem>
            }
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public EventCallback OnReady { get; set; }  // Ajout du callback
    private ConsoResume consoResume;

    protected override async Task OnInitializedAsync()
    {
        consoResume = await InfosConsoService.GetConsoResume();
        await OnReady.InvokeAsync(); // Notifier le parent
        StateHasChanged();
    }
}

