@inherits LayoutComponentBase

@using Microsoft.Extensions.Options
@using BlazingConso.Configuration
@using BlazingConso.Components.Navigation
@using MudBlazor.Services

@inject IOptions<AppInfos> AppInfosOptions

<MudThemeProvider Theme="@theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Width="160px">

        <MudDrawerHeader>
            <MudAvatar Style="margin-left:-6px; margin-top: 7px;">
                <MudImage Src="assets/logo-CC.png" Width="50" Height="50" />
            </MudAvatar>
            <MudText Typo="Typo.h6" Color="Color.Primary" Style="margin-top:0px; margin-left:10px;">Blazing</MudText>
            <MudText Typo="Typo.h6" Color="Color.Primary" Style="margin-top:25px; margin-left:-67px;">Conso</MudText>
        </MudDrawerHeader>

        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="mt-0 mb-0 pt-4 pl-4 pr-4 pb-0" Style="background-color: #edf4f7; min-height: calc(100vh - 46px);">
        @Body
    </MudMainContent>

</MudLayout>

<footer class="page-footer">
    <MudText Typo="Typo.caption" Align="Align.Center">BlazingConso - Version @AppInfosOptions.Value.Version - ©Copyright @AppInfosOptions.Value.Copyright - Tous droits réservés</MudText>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .page-layout {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .page-content {
        flex: 1 0 auto;
        min-height: 100vh; /* Pour forcer l'expansion du fond */
    }

    .page-footer {
        flex-shrink: 0;
        padding: 12px;
        background-color: #edf4f7;
        color: #0f172a;
        text-align: center;
        font-size: 0.95rem;
    }

    .logo-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 70px; /* Ajustable à ton besoin */
        padding-top: -30px;
        margin-top: -30px;
    }
</style>