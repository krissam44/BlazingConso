@page "/dashboard-jours-mois"

@inject IConsoDayService ConsodayService

<MudText Class="d-flex align-left justify-left" Typo="Typo.h6">
    @TitrePeriode
</MudText>

<MudPaper Elevation="0" Class="d-flex flex-column mt-4"
          Style="overflow: hidden; min-height: calc(100vh - 110px); width: calc(100vw - 500px); background-color: #edf4f7;">

    <!-- Contenu scrollable -->
    <MudGrid Spacing="4" Class="overflow-auto">

        @*-------------------------------------------------- ConsoChart ------------------------------------------------------*@  
        <MudItem xs="12" md="12">
            <ConsoJoursDuMoisChart ConsoChartData="@ConsoChartData" CoutChartData="@CoutChartData" ModeAffichage="@Mode" />
        </MudItem>

        @*------------------------------------- Toutes les journées du mois en cours -----------------------------------------*@  
        <MudItem xs="12" md="12">
            <ConsoJoursDuMoisGrid ConsoDays="@consoDays" GridHeight="@GridHeight" allowPaging="@allowPaging" />
        </MudItem>

    </MudGrid>

    <!-- Contenu fixe à droite -->
    <MudPaper Elevation="4" Class="d-flex flex-column" Style="width: 300px; position: fixed; top: 0; right: 0; height: 100vh; background-color:white;">
        <MudPaper Class="pa-0" Style="background-color: #f5f5f5; height: 100%;">

            <!-- 1. En-tête grise foncée avec icône et texte alignés à gauche, angles droits -->
            <MudPaper Class="d-flex align-items-center px-3"
            Style="background-color: #e0e0e0; padding-top: 12px; padding-bottom: 12px; border-radius: 0;">
                <MudIcon Icon="@Icons.Material.Filled.Tune" Style="font-size: 2rem;" />
                <MudSpacer />
                <MudText Class="pr-4" Typo="Typo.h6">Sélection</MudText>
            </MudPaper>

            <!-- ESPACE -->
            <div style="height: 48px;"></div>

            <!-- 2. DateRangePicker -->

            <MudText Class="pl-5 mb-1" Typo="Typo.body2">Choisir une période</MudText>
            <div class="px-4">
                <SfDateRangePicker TValue="DateTime"
                @bind-StartDate="@startDate" @bind-EndDate="@endDate"
                Placeholder="Sélectionnez une période"
                Style="width: 100%;"
                FullScreen="true" ShowClearButton="true">

                    @*<DateRangePickerEvents TValue="DateTime" ValueChange="ValueChangeHandler"></DateRangePickerEvents>*@

                    <DateRangePickerPresets>
                        <DateRangePickerPreset Label="Cette semaine" Start="@WeekStart" End="@WeekEnd"></DateRangePickerPreset>
                        <DateRangePickerPreset Label="Semaine dernière" Start="@LastWeekStart" End="@LastWeekEnd"></DateRangePickerPreset>
                        <DateRangePickerPreset Label="Ce mois-ci" Start="@MonthStart" End="@MonthEnd"></DateRangePickerPreset>
                        <DateRangePickerPreset Label="Mois dernier" Start="@LastMonthStart" End="@LastMonthEnd"></DateRangePickerPreset>
                        <DateRangePickerPreset Label="Trimestre dernier" Start="@LastQuarterStart" End="@LastQuarterEnd"></DateRangePickerPreset>
                        <DateRangePickerPreset Label="Année dernière" Start="@LastYearStart" End="@LastYearEnd"></DateRangePickerPreset>
                    </DateRangePickerPresets>

                </SfDateRangePicker>
            </div>

            <!-- ESPACE -->
            <div style="height: 48px;"></div>

            <div class="px-4">
                <MudText Class="pl-1 mb-0" Typo="Typo.body2">Tableau avec pagination ?</MudText>
                <div class="d-flex align-items-center">
                    <MudSwitch @bind-Value="allowPaging"
                    ThumbIcon="@(allowPaging == true ? Icons.Material.Filled.LastPage : Icons.Material.Filled.Elevator)"
                    ThumbIconColor="@(allowPaging == true ? Color.Success : Color.Error)">
                    </MudSwitch>
                    <MudText Class="mt-1 ml-3 pt-1">@((allowPaging ? "Tableau avec Pagination" : "Tableau avec scroll"))</MudText>
                </div>
            </div>

            <!-- ESPACE -->
            <div style="height: 48px;"></div>

            <div class="px-4">
                <MudText Class="pl-1 mb-0" Typo="Typo.body2">Unité d'affichage du graphique</MudText>
                <div class="d-flex align-items-center">
                    <MudSwitch @bind-Value="isAffichagekWh"
                    ThumbIcon="@(isAffichagekWh == true ? Icons.Material.Filled.ElectricBolt : Icons.Material.Filled.Euro)"
                    ThumbIconColor="@(isAffichagekWh == true ? Color.Success : Color.Error)">
                    </MudSwitch>
                    <MudText Class="mt-1 ml-3 pt-1">@((isAffichagekWh ? "Unité : kWh" : "Unité : €"))</MudText>
                </div>
            </div>

            <!-- ESPACE -->
            <div style="height: 48px;"></div>

            <!-- 4. Bouton centré -->
            <div class="d-flex justify-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AfficherDonnees">
                    Appliquer
                </MudButton>
            </div>

        </MudPaper>
    </MudPaper>
</MudPaper>

<style>
    /* To specify height and font size */
    .e-input-group input.e-input, .e-input-group.e-control-wrapper input.e-input {
        font-size: 14px;
        height: 40px;
    }

</style>
