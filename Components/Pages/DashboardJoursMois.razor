@page "/dashboard-jours-mois"

@using BlazingConso.Entities
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor
@using System.Globalization

@inject IConsoDayService ConsodayService

<ResizeHandler OnHeightChanged="@HandleResize" />

<MudText Class="d-flex align-left justify-left " Typo="Typo.h6">Plusieurs Jours</MudText>

<MudContainer Class="mt-6 px-0" MaxWidth="MaxWidth.ExtraLarge">
    <MudGrid>
        <MudItem xs="12">
            <MudCard Class="card-custom-style" style="height:100%">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Class="d-flex align-center justify-center mud-width-full" Typo="Typo.h6">
                            Détail journalier de la consommation sur une période
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Class="pt-0">
                        <!-- Option 1 : Choix de la durée -->
                        <MudItem xs="2">
                            <MudSelect T="int" Label="Durée (jours)" @bind-Value="selectedDuration">
                                <MudSelectItem Value="15">15 jours</MudSelectItem>
                                <MudSelectItem Value="30">30 jours</MudSelectItem>
                                <MudSelectItem Value="60">60 jours</MudSelectItem>
                                <MudSelectItem Value="90">90 jours</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <!-- Option 2 : Mode de sélection -->
                        <MudItem xs="3">
                            <MudSelect T="string" Label="Mode de sélection" @bind-Value="selectedMode">
                                <MudSelectItem Value="@("debut")">À partir d’une date de début</MudSelectItem>
                                <MudSelectItem Value="@("fin")">À partir d’une date de fin</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <!-- DatePicker selon le mode -->
                        <MudItem xs="2">
                            @if (selectedMode == "debut")
                            {
                                <MudDatePicker Label="Date de début" @bind-Date="startDate" />
                            }
                            else if (selectedMode == "fin")
                            {
                                <MudDatePicker Label="Date de fin" @bind-Date="endDate" />
                            }
                        </MudItem>

                        <!-- Date calculée -->
                        <MudItem xs="2">
                            @if (selectedMode == "debut")
                            {
                                <MudDatePicker Label="Date de fin" @bind-Date="endDate" Disabled="true" Color="Color.Error" />
                            }
                            else if (selectedMode == "fin")
                            {
                                <MudDatePicker Label="Date de début" @bind-Date="startDate" Disabled="true" />
                            }
                        </MudItem>

                        <MudItem xs="3" Class="d-flex justify-center align-center">
                            <MudButton OnClick="@LoadData" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Upload" Color="Color.Success">Charger</MudButton>
                        </MudItem>

                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="6" sm="6">
            @if (consoDays == null)
            {
                <p>Chargement des données...</p>
            }
            else if (consoDays.Count() == 0)
            {
                <p>Aucune donnée trouvée pour ce mois.</p>
            }
            else
            {
                <ConsoJoursDuMoisGrid ConsoDays="@consoDays" GridHeight="@GridHeight" ToolbarItems="@ToolbarItems" />
            }
        </MudItem>
        <MudItem xs="6" sm="6">
            <ConsoJoursDuMoisChart ConsoChartData="@ConsoChartData" ChartHeight="@ChartHeight" />
        </MudItem>
    </MudGrid>
</MudContainer>


@code {
    [Parameter] public EventCallback OnReady { get; set; }

    private SfGrid<ConsoDay> ConsoGrid;
    private string GridHeight = "400px";
    private string ChartHeight = "620px";
    public string[] ToolbarItems = new string[] { "ColumnChooser" };

    IEnumerable<ConsoDay> consoDays = new List<ConsoDay>();

    private bool isLoading = false;

    // ----- Liste des données de consommation pour le graphique
    private List<HistoDayData> ConsoChartData { get; set; } = new();


    // ---------------------------------------------------------------------------------------------------
    private int _selectedDuration = 30;
    private int selectedDuration
    {
        get => _selectedDuration;
        set
        {
            if (_selectedDuration != value)
            {
                _selectedDuration = value;
                RecalculateDates();
                StateHasChanged();
            }
        }
    }


    // ---------------------------------------------------------------------------------------------------
    private string _selectedMode = "fin";
    private string selectedMode
    {
        get => _selectedMode;
        set
        {
            if (_selectedMode != value)
            {
                _selectedMode = value;
                RecalculateDates();
                StateHasChanged();
            }
        }
    }


    // ---------------------------------------------------------------------------------------------------
    private DateTime? _startDate = DateTime.Today.AddDays(-30);
    private DateTime? startDate
    {
        get => _startDate;
        set
        {
            if (_startDate != value)
            {
                _startDate = value;
                RecalculateDates();
                StateHasChanged();
            }
        }
    }


    // ---------------------------------------------------------------------------------------------------
    private DateTime? _endDate = DateTime.Today;
    private DateTime? endDate
    {
        get => _endDate;
        set
        {
            if (_endDate != value)
            {
                _endDate = value;
                RecalculateDates();
                StateHasChanged();
            }
        }
    }


    // ---------------------------------------------------------------------------------------------------
    // Méthode pour recalculer les dates en fonction de la durée et du mode
    private void RecalculateDates()
    {
        if (selectedMode == "debut" && startDate.HasValue)
        {
            // ----- Calculer la date de fin en fonction de la durée et de la date de début
            endDate = startDate.Value.AddDays(selectedDuration);
        }
        else if (selectedMode == "fin" && endDate.HasValue)
        {
            // ----- Calculer la date de début en fonction de la durée et de la date de fin
            startDate = endDate.Value.AddDays(-selectedDuration);
        }
    }


    // ---------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync()
    {
        RecalculateDates();
        await LoadData();
    }


    // ---------------------------------------------------------------------------------------------------
    private async Task LoadData()
    {
        isLoading = true;
        RecalculateDates();
        StateHasChanged();

        if (startDate == null || endDate == null)
            return;

        try
        {
            consoDays = await ConsodayService.GetConsoDaysPeriod(startDate, endDate);

            if (consoDays.Any())
            {
                ConsoChartData = consoDays.Select(cd => new HistoDayData
                    {
                        DateJour = DateTime.Parse(cd.DateJour),
                        Consommation = cd.ConsoJourTotal.HasValue ? (decimal?)cd.ConsoJourTotal.Value / 1000m : null
                    }).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Erreur de chargement : {ex.Message}");
        }

        isLoading = false;
        StateHasChanged();
    }


    // ---------------------------------------------------------------------------------------------------
    private async Task RefreshData()
    {
        await LoadData();
    }


    // ---------------------------------------------------------------------------------------------------
    private void HandleResize(int availableHeight)
    {
        var gridUsableHeight = availableHeight - 400;
        var chartUsableHeight = availableHeight - 250;

        GridHeight = $"{gridUsableHeight}px";
        ChartHeight = $"{chartUsableHeight}px";
        StateHasChanged();
    }


    // ---------------------------------------------------------------------------------------------------
    public void TooltipRender(TooltipRenderEventArgs args)
    {
        double pointYValue = Convert.ToDouble(args.Data.PointY);
        string value = pointYValue.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
        args.Text = $"<b>{value}</b>";
    }


    // ---------------------------------------------------------------------------------------------------
    private static String[] ChartPalette = new String[] { "#4a86ff", "#ffb545", "#E94649", "#6FAAB0" };
    private static String[] ColorPalette = new string[] { "rgb(43, 112, 184)", "rgb(128, 188, 0)", "rgb(70, 194, 203)", "#C12138", "#EB7726", "#E8C41E" };
}

<style>
    .mud-grid-spacing-xs-6 > .mud-grid-item {
        padding-left: 24px;
        padding-top: 16px;
    }
</style>