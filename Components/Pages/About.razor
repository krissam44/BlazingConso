@page "/about"

@using BlazingConso.Configuration
@using Microsoft.Extensions.Options
@inject IOptions<AppInfos> AppInfosOptions

<MudContainer Class="d-flex justify-center align-center" Style="min-height: calc(100vh - 120px);">
    <MudPaper Elevation="25" Width="450px" Class="pa-16">
        <div class="d-flex flex-column align-center text-center">
            <img src="/assets/logo-CC-188x55.png" width="300" />

            <MudText Typo="Typo.h4" Class="my-5" GutterBottom="true" Color="Color.Primary">BlazingConso</MudText>

            <MudText Typo="Typo.h6" Class="mt-5" Color="Color.Info">Application</MudText>
            <MudText Typo="Typo.h6" Color="Color.Info">de suivi et d'analyse</MudText>
            <MudText Typo="Typo.h6" Color="Color.Info">de ma consommation électrique.</MudText>

            <MudText Typo="Typo.body2" Class="mt-8" Color="Color.Secondary">Version @AppInfosOptions.Value.Version</MudText>
            <MudText Typo="Typo.body2" Class="mb-5" Color="Color.Secondary">Copyright @AppInfosOptions.Value.Copyright</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Auteur : @AppInfosOptions.Value.Author</MudText>
        </div>
    </MudPaper>
</MudContainer>