@page "/chatgpt"
@using System.Globalization
@using Syncfusion.Blazor.Charts

<MudPaper Class="pa-4">
    <MudStack Row AlignItems="@AlignItems.Center" Spacing="2">
        <MudSwitch T="bool" @bind-Checked="afficheEuros" Color="Color.Primary" label=@(afficheEuros ? "Affichage du graphe en kWh" : "Affichage du graphe en €")>
        </MudSwitch>

        <MudSelect @bind-Value="selectedPeriode" Label="Période" Dense="true" Class="w-25">
            <MudSelectItem Value="7">7 jours</MudSelectItem>
            <MudSelectItem Value="30">30 jours</MudSelectItem>
            <MudSelectItem Value="365">1 an</MudSelectItem>
        </MudSelect>

    </MudStack>

    <MudCard Class="mt-3 mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6">Total : <b>@TotalAffiché.ToString("0.00")</b> @Unité</MudText>
        </MudCardContent>
    </MudCard>

    <SfChart @ref="chartObj" Title="Consommation électrique">
        <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime"
                           Title="Date" LabelFormat="dd/MM" />
        <ChartPrimaryYAxis Title="@TitreY" LabelFormat="@($"{LabelFormat} {Unité}")" />

        <ChartSeriesCollection>
            <ChartSeries DataSource="@consoData"
                         XName="Date"
                         YName="@(afficheEuros? nameof(ConsoData.Euros) : nameof(ConsoData.kWh))"
                         Type="ChartSeriesType.Column"
                         Name="@TitreSerie"
                         TooltipMappingName="@(afficheEuros? nameof(ConsoData.TooltipEuros) : nameof(ConsoData.TooltipKwh))">
            </ChartSeries>
        </ChartSeriesCollection>

        <ChartTooltipSettings Enable="true" Format="@TooltipFormat" />
        <ChartExportSettings Type="ExportType.PNG" />
    </SfChart>
</MudPaper>

@code {
    private SfChart chartObj;
    private bool afficheEuros = false;
    private int selectedPeriode = 30;

    private string Unité = "€"; // ou "kWh", selon le contexte
    private string TooltipFormat => $"${{point.x:dd/MM/yyyy}} - {{point.y}} {Unité}";

    private List<ConsoData> allData;
    private List<ConsoData> consoData => allData
        .Where(d => d.Date >= DateTime.Today.AddDays(-selectedPeriode))
        .ToList();

    private string Unit => afficheEuros ? "€" : "kWh";
    private string TitreY => afficheEuros ? "Coût (Euros)" : "Consommation (kWh)";
    private string TitreSerie => afficheEuros ? "Coût journalier" : "Conso journalière";
    private string LabelFormat => "{value}";

    private double TotalAffiché => afficheEuros
        ? consoData.Sum(d => d.Euros)
        : consoData.Sum(d => d.kWh);

    protected override void OnInitialized()
    {
        // Simulation de données sur 365 jours
        allData = Enumerable.Range(0, 365).Select(i =>
        {
            var date = DateTime.Today.AddDays(-i);
            var kwh = Random.Shared.NextDouble() * 10 + 5;
            var euros = kwh * 0.18;

            return new ConsoData
            {
                Date = date,
                kWh = Math.Round(kwh, 2),
                Euros = Math.Round(euros, 2),
                TooltipKwh = $"{kwh:0.00} kWh",
                TooltipEuros = $"{euros:0.00} €"
            };
        }).ToList();
    }

    public class ConsoData
    {
        public DateTime Date { get; set; }
        public double kWh { get; set; }
        public double Euros { get; set; }
        public string TooltipKwh { get; set; }
        public string TooltipEuros { get; set; }
    }
}
