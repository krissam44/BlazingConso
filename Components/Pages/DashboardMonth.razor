@page "/dashboard-month"

@using System.Globalization
@using BlazingConso.Dtos
@using BlazingConso.Entities
@using BlazingConso.Enums

@inject IConsoMonthService ConsoMonthService

<ResizeHandler OnHeightChanged="@HandleResize" />

<MudText Class="d-flex align-left justify-left " Typo="Typo.h6">Mois</MudText>

<MudContainer Class="mt-6 px-0" MaxWidth="MaxWidth.ExtraLarge">
    <MudGrid Spacing="4">
        <MudItem xs="12">
            <MudCard Class="card-custom-style">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Class="d-flex align-center justify-center mud-width-full" Typo="Typo.h6">
                            Consommations Mensuelles
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    <MudGrid Class="pt-0">
                        <MudItem xs="2">
                            <MudSelect T="int" Label="Mois début d'analyse" Value="startMonth" ValueChanged="@OnStartMonthChanged">
                                @foreach (var mois in moisList)
                                {
                                    <MudSelectItem Value="@mois.Id">@mois.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="2">
                            <MudSelect T="int" Label="Année début d'analyse" Value="startYear" ValueChanged="@OnStartYearChanged">
                                @foreach (var year in Enumerable.Range(DateTime.Today.Year - 5, 6))
                                {
                                    <MudSelectItem Value="@year">@year</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="2">
                            <MudSelect T="int" Label="Mois fin d'analyse" Value="endMonth" ValueChanged="@OnEndMonthChanged">
                                @foreach (var mois in moisList)
                                {
                                    <MudSelectItem Value="@mois.Id">@mois.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="2">
                            <MudSelect T="int" Label="Année fin d'analyse" Value="endYear" ValueChanged="@OnEndYearChanged">
                                @foreach (var year in Enumerable.Range(DateTime.Today.Year - 5, 6))
                                {
                                    <MudSelectItem Value="@year">@year</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="2">
                            <MudSelect T="ModeAffichage" @bind-Value="Mode" Label="Unité d'affichage du Graphe">
                                <MudSelectItem Value="ModeAffichage.kWh">kWh</MudSelectItem>
                                <MudSelectItem Value="ModeAffichage.Euros">€</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="2" Class="d-flex justify-center align-center">
                            <MudButton OnClick="@LoadData"
                                       Variant="Variant.Filled" Color="Color.Primary">
                                Appliquer
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @if (!isDataReady)
        {
            <p>Chargement des données...</p>
        }
        else if (consoMonths.Count() == 0)
        {
            <p>Aucune donnée trouvée pour ce mois.</p>
        }
        else
        {
            <MudItem xs="6" sm="6">
                <ConsoMonthsGrid ConsoMonths="@consoMonths" GridHeight="@GridHeight" ToolbarItems="@ToolbarItems" />
            </MudItem>
            <MudItem xs="6" sm="6">
                <ConsoMonthsChart ConsoChartData="@consoChartData" CoutChartData="@coutChartData" ModeAffichage="@Mode" ChartHeight="@ChartHeight" />
            </MudItem>
        }

    </MudGrid>
</MudContainer>

@code {
    private int startMonth = DateTime.Today.Month;
    private int startYear = DateTime.Today.Year - 1;
    private int endMonth = DateTime.Today.Month;
    private int endYear = DateTime.Today.Year;

    private ModeAffichage Mode = ModeAffichage.kWh;
    private bool isAffichagekWh
    {
        get => Mode == ModeAffichage.kWh;
        set => Mode = value ? ModeAffichage.kWh : ModeAffichage.Euros;
    }

    private IEnumerable<ConsoMonth> consoMonths = new List<ConsoMonth>();
    // ----- Liste des données de consommation pour le graphique version consommation
    private List<MonthlyChartConsoDto> consoChartData { get; set; } = new();
    // ----- Liste des données de consommation pour le graphique version coût
    private List<MonthlyChartCoutDto> coutChartData { get; set; } = new();

    private SfGrid<ConsoMonth> ConsoMonth;
    private string GridHeight = "400px";
    private string ChartHeight = "400px";
    public string[] ToolbarItems = new string[] { "ColumnChooser" };

    private bool isDataReady = false;

    // ---------------------------------------------------------------------------------------------------
    private List<(int Id, string Name)> moisList = Enumerable.Range(1, 12)
        .Select(i => (i, CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)))
        .ToList();


    private void OnSwitchChanged(bool newValue)
    {
        // Logique à exécuter lors du changement d'état
    }

    // ---------------------------------------------------------------------------------------------------
    private void OnStartMonthChanged(int value)
    {
        startMonth = value;
        ValidateDates();
    }

    // ---------------------------------------------------------------------------------------------------
    private void OnStartYearChanged(int value)
    {
        startYear = value;
        ValidateDates();
    }

    // ---------------------------------------------------------------------------------------------------
    private void OnEndMonthChanged(int value)
    {
        endMonth = value;
        ValidateDates();
    }

    // ---------------------------------------------------------------------------------------------------
    private void OnEndYearChanged(int value)
    {
        endYear = value;
        ValidateDates();
    }

    // ---------------------------------------------------------------------------------------------------
    private void HandleResize(int availableHeight)
    {
        var gridUsableHeight = availableHeight - 440;
        var chartUsableHeight = availableHeight - 325;

        GridHeight = $"{gridUsableHeight}px";
        ChartHeight = $"{chartUsableHeight}px";
        StateHasChanged();
    }

    // ---------------------------------------------------------------------------------------------------
    private void ValidateDates()
    {
        var startDate = new DateTime(startYear, startMonth, 1);
        var endDate = new DateTime(endYear, endMonth, 1);
        if (startDate > endDate)
        {
            // Ajustement automatique : ici on synchronise end = start
            endYear = startYear;
            endMonth = startMonth;
        }
    }


    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            LoadData();
        }
    }

    // ---------------------------------------------------------------------------------------------------
    private async void LoadData()
    {
        try
        {
            consoMonths = await ConsoMonthService.GetConsoMonthsOfYearAsync(startMonth, startYear, endMonth, endYear);

            consoChartData = consoMonths.Select(cm => new MonthlyChartConsoDto
                {
                    Periode = cm.periode,
                    ConsoHP = cm.ConsoHPkWh,
                    ConsoHC = cm.ConsoHCkWh
                }).ToList();

            coutChartData = consoMonths.Select(cm => new MonthlyChartCoutDto
                {
                    Periode = cm.periode,
                    CoutConsommationHP = cm.coutConsommationHP.HasValue ? cm.coutConsommationHP.Value : null,
                    CoutConsommationHC = cm.coutConsommationHC.HasValue ? cm.coutConsommationHC.Value : null,
                    CoutTotal = cm.coutTotal.HasValue ? cm.coutTotal.Value : null
                }).ToList();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Erreur de chargement : {ex.Message}");
        }

        isDataReady = true;
        StateHasChanged();
    }
}


<style>
    .mud-grid-spacing-xs-6 > .mud-grid-item {
        padding-left: 24px;
        padding-top: 16px;
    }
</style>