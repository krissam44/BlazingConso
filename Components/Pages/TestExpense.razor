@page "/testExpense"

<MudText Class="d-flex align-left justify-left" Typo="Typo.h6">TestExpense</MudText>

<MudPaper Elevation="0" Class="d-flex flex-column mt-4"
          Style=" overflow: hidden; min-height: calc(100vh - 110px); width: calc(100vw - 450px); background-color: #edf4f7">
    <!-- Contenu scrollable -->
        <MudGrid Spacing="6">
            @*---------------------------------------------- Instantanée lINKY ---------------------------------------------------*@
            <MudItem xs="12" sm="6" md="3">
                <InstantaneeLinky />
            </MudItem>

            @*------------------------------------------ Consommation de la journée ----------------------------------------------*@
            <MudItem xs="12" sm="6" md="3">
                <ConsoDuJour />
            </MudItem>

            @*-------------------------------------------- Consommation du mois --------------------------------------------------*@
            <MudItem xs="12" sm="6" md="3">
                <ConsoDelta />
            </MudItem>

            @*-------------------------------------------- xxxxxxxxxxxxxxxxxxxx --------------------------------------------------*@
            <MudItem xs="12" sm="6" md="3">
                <SyntheseCouts />
            </MudItem>

            @*------------------------------------- Toutes les journées du mois en cours -----------------------------------------*@
            <MudItem xs="12" md="7">
                <Conso30Chart GridHeight="600" />
            </MudItem>

            @*----------------------------------------- ConsoChart ----------------------------------------------*@
            <MudItem xs="12" md="5">
                <ConsoBy3HChart ChartHeight="800" />
            </MudItem>

        @*------------------------------------- Toutes les journées du mois en cours -----------------------------------------*@
        <MudItem xs="12" md="7">
            <Conso30Chart GridHeight="600" />
        </MudItem>

        @*----------------------------------------- ConsoChart ----------------------------------------------*@
        <MudItem xs="12" md="5">
            <ConsoBy3HChart ChartHeight="800" />
        </MudItem>
        </MudGrid>

    <!-- Contenu fixe à droite -->
    <MudPaper Elevation="4" Class="d-flex flex-row " Style="width: 250px; position: fixed; top: 0; right: 0; height: 100vh; background-color:white">
        <!-- Composants MudBlazor ici -->
        <p>Ceci est un autre texte dans la colonne de droite</p>
    </MudPaper>
   
</MudPaper>


<style>
    .mud-card-header {
        padding-top: 8px;
        padding-bottom: 8px;
    }

    .mud-card-content {
        padding-top: 0px;
        padding-bottom: 8px;
    }

</style>

