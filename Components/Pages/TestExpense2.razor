@page "/testExpense2"

<MudText Class="d-flex align-left justify-left" Typo="Typo.h6">TestExpense</MudText>

<MudPaper Class="layout-container">
    <!-- Colonne gauche : contenu scrollable -->
    <div class="left-column">
        <MudGrid Spacing="6">
            <MudItem xs="12" sm="6" md="3">
                <InstantaneeLinky />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <ConsoDuJour />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <ConsoDelta />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <SyntheseCouts />
            </MudItem>
            <MudItem xs="12" md="7">
                <Conso30Chart GridHeight="700" />
            </MudItem>
            <MudItem xs="12" md="5">
                <ConsoBy3HChart ChartHeight="700" />
            </MudItem>
        </MudGrid>
    </div>

    <!-- Colonne droite : fixe -->
    <MudPaper class="right-column">
        <MudPaper Elevation="8" Class="p-4">
            <p>Ceci est un autre texte</p>
            <!-- Ajoutez ici d'autres composants MudBlazor si nécessaire -->
        </MudPaper>
    </MudPaper>
</MudPaper>


<style>
    .layout-container {
        display: flex;
        height: calc(100vh - 46px); /* Ajustement pour le footer */
        overflow: hidden;
    }

    .left-column {
        width: calc(100vw - 410px); /* 160px (menu) + 250px (colonne droite) */
        overflow-y: auto;
        background-color: midnightblue;
        padding-right: 32px;
        padding-top:0px;
        margin-top: 32px;
        margin-left: 0px;
    }

    .right-column {
        width: 250px;
        height: calc(100vh-40px);
        position: fixed;
        top: 0;
        right: 0;
        background-color: #e0e0e0;
        padding: 16px;
    }
</style>
