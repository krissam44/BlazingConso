@page "/dashboard-1-jour"

@using BlazingConso.Dtos
@using BlazingConso.Entities
@using BlazingConso.Enums
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor
@using System.Globalization

@inject IInfosConsoService InfosConsoService

<ResizeHandler OnHeightChanged="@HandleResize" />

<MudText Class="d-flex align-left justify-left " Typo="Typo.h6">Détail d'un Jour</MudText>

<MudContainer Class="mt-6 px-0" MaxWidth="MaxWidth.ExtraLarge">
    <MudGrid Spacing="4">
        <MudItem xs="12">
            <MudCard Class="card-custom-style" style="height:100%">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Class="d-flex align-center justify-center mud-width-full" Typo="Typo.h6">
                            Détail de la consommation d'une journée
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Class="pt-0">
                        <MudItem xs="2">
                            <MudDatePicker Label="Quelle journée ?" Editable="true" @bind-Date="dateJour" />
                        </MudItem>
                        <MudItem xs="2">
                            <MudSelect T="ModeAffichage" @bind-Value="Mode" Label="Unité d'affichage du Graphe">
                                <MudSelectItem Value="ModeAffichage.kWh">kWh</MudSelectItem>
                                <MudSelectItem Value="ModeAffichage.Euros">€</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="2" Class="d-flex justify-center align-center">
                            <MudButton OnClick="@LoadData"
                                       Variant="Variant.Filled" Color="Color.Primary">
                                Appliquer
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="5" Style="height:85%">
            <Conso1HeureGrid consoGridData="@consoHoraireData" GridHeight="@GridHeight" ToolbarItems="@ToolbarItems" />
        </MudItem>

        <MudItem xs="7" Style="height:85%">
            <Conso1HeureChart consoChartData="@consoChartData" coutChartData="@coutChartData" ModeAffichage="@Mode" ChartHeight="@ChartHeight" />
        </MudItem>

    </MudGrid>
</MudContainer>


@code {
    private DateTime? dateJour = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day);

    private ModeAffichage Mode = ModeAffichage.kWh;
    private bool isAffichagekWh
    {
        get => Mode == ModeAffichage.kWh;
        set => Mode = value ? ModeAffichage.kWh : ModeAffichage.Euros;
    }

    private string GridHeight = "400px";
    private string ChartHeight = "620px";

    private string[] ToolbarItems = new string[] { "ColumnChooser" };

    private IEnumerable<ConsoHoraire> consoHoraireData = new List<ConsoHoraire>();

    private List<HistoPeriodConsoDto> consoChartData { get; set; } = new();
    private List<HistoPeriodCoutDto> coutChartData { get; set; } = new();

    private bool isLoading = false;


    // ---------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    // ---------------------------------------------------------------------------------------------------
    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            consoHoraireData = await InfosConsoService.GetConsoBy1H(dateJour.Value);

            if (consoHoraireData != null && consoHoraireData.Any())
            {
                consoChartData = consoHoraireData.Select(cd => new HistoPeriodConsoDto
                    {
                        Periode = cd.TrancheHoraire,
                        Consommation = cd.TotalConso.Value / 1000m
                    }).ToList();

                coutChartData = consoHoraireData.Select(cd => new HistoPeriodCoutDto
                    {
                        Periode = cd.TrancheHoraire,
                        CoutConsommation = cd.coutConsommation
                    }).ToList();
            }
            else
            {
                consoChartData = new List<HistoPeriodConsoDto>();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Erreur de chargement des données de consommation : {ex.Message}");
            consoChartData = new List<HistoPeriodConsoDto>(); // éviter une liste null en cas d'erreur
        }

        isLoading = false;
        StateHasChanged();
    }


    // ---------------------------------------------------------------------------------------------------
    private async Task RefreshData()
    {
        await LoadData();
    }


    // ---------------------------------------------------------------------------------------------------
    private void HandleResize(int availableHeight)
    {
        var gridUsableHeight = availableHeight - 390;
        var chartUsableHeight = availableHeight - 300;

        GridHeight = $"{gridUsableHeight}px";
        ChartHeight = $"{chartUsableHeight}px";
        StateHasChanged();
    }


    // ---------------------------------------------------------------------------------------------------
    public void TooltipRender(TooltipRenderEventArgs args)
    {
        double pointYValue = Convert.ToDouble(args.Data.PointY);
        string value = pointYValue.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
        args.Text = $"<b>{value}</b>";
    }


    // ---------------------------------------------------------------------------------------------------
    private static String[] ChartPalette = new String[] { "#4a86ff", "#ffb545", "#E94649", "#6FAAB0" };
    private static String[] ColorPalette = new string[] { "rgb(43, 112, 184)", "rgb(128, 188, 0)", "rgb(70, 194, 203)", "#C12138", "#EB7726", "#E8C41E" };
}


<style>
    .mud-grid-spacing-xs-6 > .mud-grid-item {
        padding-left: 24px;
        padding-top: 16px;
    }
</style>